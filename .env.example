TARGET_DB_URL=mysql+asyncmy://nl2sql_ro:CHANGE_ME@127.0.0.1:3307/ecommerce
TARGET_DATABASES={}               # optional JSON mapping of alias -> URL: {"analytics": "..."}
APP_DB_PATH=backend/data/app.db
SQL_LOG_PATH=backend/data/sql_log.jsonl
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192             # 16 GB Mac; raise only if the schema prompt doesn't fit
MAX_ROWS=500
ANSWER_MAX_ROWS=50
QUERY_TIMEOUT_MS=10000
MAX_REPAIR_ATTEMPTS=2
MAX_QUERIES=3
EXPLAIN_MAX_COST=5000000
EXPLAIN_MAX_ROWS=10000000
EXPLAIN_WARN_ROWS=100000
HISTORY_TURNS=4
SCHEMA_FULL_MAX_TABLES=40
SCHEMA_SAMPLE_VALUES=true
ALLOWED_FUNCTIONS=
DENY_TABLES=
DENY_COLUMNS=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE=/api        # frontend; proxied via next.config rewrites → 127.0.0.1:8000
KNOWLEDGE_BOT_URL=http://127.0.0.1:8100
KNOWLEDGE_BOT_API_KEY=
KNOWLEDGE_BOT_ADMIN_KEY=
KNOWLEDGE_BOT_TIMEOUT_SEC=90.0
KNOWLEDGE_BOT_REFRESH_TIMEOUT_SEC=900.0   # POST /admin/refresh answers only when the fetch is done
# Settings page (Jira/Slack credentials). Local-only until login exists: the
# browser calls the backend directly (not through the Next.js proxy), so open the
# app from an origin listed in CORS_ORIGINS on the same machine as the backend.
ENABLE_SETTINGS_UI=false
NEXT_PUBLIC_SETTINGS_API_BASE=http://127.0.0.1:8000/api   # frontend; direct, never proxied
